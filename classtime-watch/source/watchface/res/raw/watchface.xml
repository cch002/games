<?xml version="1.0" encoding="utf-8"?>
<!--
  Class Time watch face (Watch Face Format v2).
  Slot 0 "Current class" (RANGED_VALUE) draws the progress ring plus the lesson
  name and countdown; slot 1 "Next class" (LONG_TEXT) sits below. Both default to
  the data sources built into the Class Time watch app (eu.nohus.classtime).
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>

  <UserConfigurations>
    <ColorConfiguration id="accent" displayName="accent_label" defaultValue="0">
      <ColorOption id="0" displayName="accent_teal" colors="#FF4FD1C5"/>
      <ColorOption id="1" displayName="accent_amber" colors="#FFF6B94C"/>
      <ColorOption id="2" displayName="accent_coral" colors="#FFF7797D"/>
      <ColorOption id="3" displayName="accent_lilac" colors="#FFB3A4F7"/>
    </ColorConfiguration>
  </UserConfigurations>

  <Scene backgroundColor="#FF000000">

    <!-- Date -->
    <PartText x="75" y="74" width="300" height="40">
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="[CONFIGURATION.accent.0]">
          <Template>%s %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/></Template>
        </Font>
      </Text>
    </PartText>

    <!-- Time: regular when active, thin in ambient -->
    <DigitalClock x="0" y="0" width="450" height="450">
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="110" width="450" height="126" alpha="255">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <Font family="SYNC_TO_DEVICE" size="112" weight="MEDIUM" color="#FFFFFFFF"/>
      </TimeText>
      <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="110" width="450" height="126" alpha="0">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <Font family="SYNC_TO_DEVICE" size="112" weight="THIN" color="#FFFFFFFF"/>
      </TimeText>
    </DigitalClock>

    <!-- Current class: progress ring + name + countdown -->
    <ComplicationSlot x="0" y="0" width="450" height="450" slotId="0" displayName="slot_now_label" supportedTypes="RANGED_VALUE EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
          primaryProvider="eu.nohus.classtime/eu.nohus.classtime.ClassNowComplicationService"
          primaryProviderType="RANGED_VALUE"/>
      <BoundingBox x="60" y="238" width="330" height="92"/>
      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="450" height="450" alpha="255">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <Arc centerX="225" centerY="225" width="422" height="422" startAngle="0" endAngle="360">
            <Stroke thickness="12" color="#FF1D252D"/>
          </Arc>
          <Arc centerX="225" centerY="225" width="422" height="422" startAngle="0" endAngle="0">
            <Stroke thickness="12" color="[CONFIGURATION.accent.0]" cap="ROUND"/>
            <Transform target="endAngle" value="360 * ((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]))"/>
          </Arc>
        </PartDraw>
        <PartText x="60" y="238" width="330" height="48">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="34" weight="SEMI_BOLD" color="[CONFIGURATION.accent.0]">
              <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
            </Font>
          </Text>
        </PartText>
        <PartText x="60" y="288" width="330" height="40">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="27" color="#FFC9D1D9">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="EMPTY">
        <PartText x="60" y="250" width="330" height="40">
          <Text align="CENTER">
            <Font family="SYNC_TO_DEVICE" size="24" color="#FF6B7682">
              <Template>%s<Parameter expression="no_class_data"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

    <!-- Next class -->
    <ComplicationSlot x="95" y="334" width="260" height="70" slotId="1" displayName="slot_next_label" supportedTypes="LONG_TEXT SHORT_TEXT EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"
          primaryProvider="eu.nohus.classtime/eu.nohus.classtime.ClassNextComplicationService"
          primaryProviderType="LONG_TEXT"/>
      <BoundingBox x="0" y="0" width="260" height="70"/>
      <Complication type="LONG_TEXT">
        <PartText x="0" y="0" width="260" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="20" weight="MEDIUM" color="#FF8A95A1">
              <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
            </Font>
          </Text>
        </PartText>
        <PartText x="0" y="28" width="260" height="38">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="26" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="0" width="260" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="20" weight="MEDIUM" color="#FF8A95A1">
              <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
            </Font>
          </Text>
        </PartText>
        <PartText x="0" y="28" width="260" height="38">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="26" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="EMPTY">
        <PartDraw x="0" y="0" width="260" height="70">
          <Line startX="100" startY="35" endX="160" endY="35">
            <Stroke thickness="2" color="#FF2A333C"/>
          </Line>
        </PartDraw>
      </Complication>
    </ComplicationSlot>

  </Scene>
</WatchFace>
